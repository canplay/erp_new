# =============================================================================
# MyAI 构建-部署流水线环境变量配置
# =============================================================================
# 复制此文件为 .env 并填入实际值:
#   cp Scripts/.env.example Scripts/.env

# Harbor 镜像仓库
HARBOR_URL=harbor.100.100.100.101.example.com:8003
HARBOR_PROJECT=erp
HARBOR_USER=admin
# HARBOR_PASS 从 ~/.myai/secrets/harbor-password 读取，或在此设置
HARBOR_PASS="${HARBOR_PASS:?Error: Set HARBOR_PASS or ~/.myai/secrets/harbor-password}"

# Rancher 集群
RANCHER_URL=https://100.100.100.101.example.com:8800
RANCHER_USER=admin
# Rancher 密码从 ~/.myai/secrets/rancher-password 读取，或在此设置

# K8s 命名空间
NAMESPACE=myai-prod

# 项目根目录（可选，默认自动定位）
# MYAI_ROOT=/path/to/MyAI
