# =============================================================================
# MyAI Admin 前端 - 生产环境变量 (quasar build / vite)
# =============================================================================
# 优先级: .env.production > .env (仅 build 模式加载)
# 生产走 Nginx 同域反代: /api → api-gateway, /ws → 消息服务
# 不需要硬编码公网 IP, 由部署环境 Nginx 配置决定
# 注意: 此文件不含任何密钥, 可安全提交 git
# =============================================================================

VITE_API_BASE_URL=/api
VITE_WS_URL=/ws/messages
VITE_APP_TITLE=MyAI Admin