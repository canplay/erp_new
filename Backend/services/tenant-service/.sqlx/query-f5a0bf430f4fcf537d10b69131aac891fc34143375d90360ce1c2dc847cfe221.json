  "query": "\n            SELECT tu.id, tu.user_id, u.username, u.email, tu.role, tu.department, tu.position,\n                   tu.status, tu.joined_at\n            FROM tenant_users tu\n            JOIN users u ON u.id = tu.user_id\n            WHERE tu.tenant_id = $1\n            ",
