{
  "name": "myai-social",
  "version": "0.1.0",
  "description": "MyAI Matrix 即时通讯客户端",
  "productName": "MyAI Social",
  "author": "CaNplay <canplay@vip.qq.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "prettier --write \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .gitignore && eslint --fix -c ./eslint.config.js \"./src/**/*.{ts,js,cjs,mjs,vue}\"",
    "lint:check": "prettier \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .gitignore && eslint -c ./eslint.config.js \"./src/**/*.{ts,js,cjs,mjs,vue}\"",
    "dev": "quasar dev",
    "build": "quasar build",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@myai-workspace/api": "workspace:*",
    "@myai-workspace/boot": "workspace:*",
    "@myai-workspace/components": "workspace:*",
    "@myai-workspace/composables": "workspace:*",
    "@myai-workspace/stores": "workspace:*",
    "@myai-workspace/types": "workspace:*",
    "@myai-workspace/utils": "workspace:*",
    "@quasar/extras": "^2.0.1",
    "matrix-js-sdk": "^41.8.0",
    "pinia": "^4.0.2",
    "quasar": "^2.20.3",
    "vue": "^3.5.39",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@intlify/unplugin-vue-i18n": "^11.2.4",
    "@quasar/app-vite": "^3.0.1",
    "@types/node": "^26.1.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "autoprefixer": "^10.5.3",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "vite-plugin-checker": "^0.14.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
