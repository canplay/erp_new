# =============================================================================
# MyAI 项目环境变量配置示例（统一模板）
# =============================================================================
# 使用方法:
#   1. 复制此文件为 .env: cp .env.example .env（后端本地开发 dotenv 自动加载）
#   2. 前端构建: Frontend/admin/.env.development / .env.production（已提交 git, 不含密钥）
#   3. 运维脚本: Scripts/.env 由 Scripts/lib/env.sh 自动加载（未创建则用脚本默认值）
#   4. K8s 部署: Scripts/helm/myai/values-prod-harbor.yaml 中的 configMap/secret 生效
#
# 环境说明:
#   dev  — 本地开发环境（cargo run / quasar dev）
#   prod — 远程集群生产环境（Rancher/K8s + Harbor）
# 注意: 生产环境唯一权威来源为 Scripts/helm/myai/values-prod-harbor.yaml
#       （configMap=非敏感, secret=敏感占位符→apply-secrets.sh 重放真实值）。
#       本文件仅用于本地开发参考与 dotenv 加载。
# =============================================================================

# =============================================================================
# 基础设施（与集群已有 pg-cluster / redis-replication 对齐）
# =============================================================================

# --- PostgreSQL（集群已有 pg-cluster-postgresql，库名 myai）---
# 本地开发（dotenv 自动加载 .env）:
# POSTGRES_DB=myai
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=<本地开发密码, 勿提交真实值>
# DATABASE_URL=postgresql://postgres:***@localhost:5432/myai
# 集群连接（生产，K8s 内部 DNS，由 apply-secrets.sh 注入）:
# DATABASE_URL=postgresql://postgres:***@pg-cluster-postgresql-postgresql.default.svc.cluster.local:5432/myai

# --- Redis（集群已有 redis-replication-redis）---
# 本地开发（dotenv 自动加载 .env）:
# REDIS_PASSWORD=<本地开发密码, 勿提交真实值>
# REDIS_URL=redis://default:***@localhost:6379/0
# 集群连接（生产，K8s 内部 DNS，由 apply-secrets.sh 注入）:
# REDIS_URL=redis://default:***@redis-replication-redis-redis.default.svc.cluster.local:6379/0

# =============================================================================
# 前端 (Frontend/admin) 环境变量
# 实际文件: Frontend/admin/.env.development / .env.production（已提交 git）
# 代码兜底: import.meta.env.VITE_API_BASE_URL || '/api'
# =============================================================================

# --- dev 模式（本地开发）---
# quasar dev 时自动加载 .env.development（优先级高于 .env）
VITE_API_BASE_URL=http://localhost:8090/api
VITE_WS_URL=ws://localhost:8090/ws
VITE_APP_TITLE=MyAI Admin (Dev)

# --- prod 模式（远程集群）---
# quasar build 时自动加载 .env.production（优先级高于 .env）
# 生产走 Nginx 同域反代: /api → api-gateway, /ws → ws 服务
VITE_API_BASE_URL=/api
VITE_WS_URL=/ws/messages
VITE_APP_TITLE=MyAI Admin

# =============================================================================
# 后端通用 (Backend) 环境变量
# 本地: dotenv 从 .env 加载; 生产: K8s ConfigMap/Secret 注入
# =============================================================================

# --- 服务端口 ---
API_GATEWAY_PORT=8090
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8080
GRPC_PORT=9090

# --- JWT ---
JWT_SECRET=<CHANGE-ME-使用 openssl rand -base64 48 生成>
JWT_ISSUER=myai
JWT_AUDIENCE=myai-users
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# --- 会话安全 ---
SESSION_MAX_LOGINS=5
SESSION_TIMEOUT_SECS=1800
DEVICE_LIMIT=3
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECS=1800

# --- API Gateway ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_BURST=20
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_SECS=60
CIRCUIT_BREAKER_HALF_OPEN_REQUESTS=3
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_MAX_AGE=3600

# --- API Gateway 上游服务 gRPC 地址（K8s 集群内部 DNS）---
AUTH_SERVICE_GRPC_URL=auth-service:9091
USER_SERVICE_GRPC_URL=user-service:9090
CMS_SERVICE_GRPC_URL=cms-service:9082
MESSAGE_SERVICE_GRPC_URL=message-service:9083
FILE_SERVICE_GRPC_URL=file-service:9092
TENANT_SERVICE_GRPC_URL=tenant-service:9095
WORKFLOW_SERVICE_GRPC_URL=workflow-service:9088
AUDIT_SERVICE_GRPC_URL=audit-service:9010
API_KEY_SERVICE_GRPC_URL=api-key-service:9014
FEEDBACK_SERVICE_GRPC_URL=feedback-service:9085
HIK_SERVICE_GRPC_URL=hik-service:9096
PAY_SERVICE_GRPC_URL=pay-service:9097
CLEAN_SERVICE_GRPC_URL=clean-service:9087
TOW_SERVICE_GRPC_URL=tow-service:9086
SOCIAL_OPS_SERVICE_GRPC_URL=social-ops-service:9110
BROWSER_SERVICE_GRPC_URL=browser-service:9120
CTP_SERVICE_GRPC_URL=ctp-service:9098
XLT_SERVICE_GRPC_URL=xlt-service:9099
EBIKE_SERVICE_GRPC_URL=ebike-service:9100

# --- 文件服务 ---
FILE_STORAGE_TYPE=local
FILE_STORAGE_PATH=/data/files
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=myai-files
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_PATH_STYLE=true
OSS_ENDPOINT=
OSS_BUCKET=myai-files
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# --- 海康设备 ---
HIK_URL=
HIK_CLIENT_ID=
HIK_CLIENT_SECRET=
HIK_APP_KEY=
HIK_APP_SECRET=

# --- 支付 ---
PAY_ENV=sandbox
CCB_MERCHANT_ID=
CCB_MERCHANT_NAME=
CCB_TERMINAL_ID=
CCB_KEY=
CCB_CERT=
CCB_SIGN_TYPE=RSA
CCB_GATEWAY_URL=
UMS_MERCHANT_ID=
UMS_TERMINAL_ID=
UMS_KEY=
UMS_GATEWAY_URL=
UMS_SIGN_TYPE=RSA
PAY_NOTIFY_URL=
PAY_RETURN_URL=

# --- 工作流 ---
WORKFLOW_SCRIPT_ENABLED=true
WORKFLOW_SCRIPT_TIMEOUT_SECS=30
WORKFLOW_MAX_EXECUTION_TIME_SECS=3600
WORKFLOW_CRON_CHECK_INTERVAL_SECS=60

# --- 浏览器自动化 ---
BROWSER_POOL_SIZE=4
BROWSER_SERVICE_GRPC=browser-service:9120

# --- 数据库连接池（共享 PG，控制单服务连接数）---
DB_POOL_MAX_CONNECTIONS=3
DB_POOL_MIN_CONNECTIONS=1
DB_POOL_CONNECT_TIMEOUT=30
DB_POOL_IDLE_TIMEOUT=300
DB_POOL_MAX_LIFETIME=1800

# --- 日志 ---
RUST_LOG=info
LOG_FORMAT=json
LOG_MAX_SIZE=100
LOG_MAX_FILES=7
LOG_DIR=/var/log

# --- OpenTelemetry（暂不启用）---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=myai-backend

# --- 时区 ---
TZ=Asia/Shanghai
