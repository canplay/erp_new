  "query": "SELECT id, name, description, definition, status, version,\n       created_by, created_at, updated_at\n       FROM workflows\n       WHERE ($1::text IS NULL OR $1 = '' OR status = $1)\n       ORDER BY created_at DESC\n       LIMIT $2 OFFSET $3",
