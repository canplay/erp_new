  "query": "SELECT id, instance_id, node_id, node_name, assignee, status,\n       form_data, started_at, completed_at\n       FROM task_records\n       WHERE ($1::text IS NULL OR instance_id = $1)\n         AND ($2 = '' OR assignee = $2)\n       ORDER BY started_at DESC\n       LIMIT $3 OFFSET $4",
