{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, user_id, username, action, resource_type, resource_id, details, ip_address,\n                   COALESCE(created_at, NOW()) AS \"created_at!\"\n            FROM audit_logs\n            WHERE tenant_id = $1\n            ORDER BY created_at DESC\n            LIMIT $2 OFFSET $3\n            ",
